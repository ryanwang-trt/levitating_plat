/* ToF bring-up: VL53L0X on the SAME i2c21 bus as the MPU-6050.
   The two addresses do not collide: VL53L0X = 0x29, MPU-6050 = 0x68, so both
   can share one bus. i2c21 is PERI-domain, so its pins must be on P1 or P3. */

&pinctrl {
	i2c21_default: i2c21_default {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 3)>,
				<NRF_PSEL(TWIM_SCL, 1, 4)>;
			bias-pull-up;
		};
	};

	i2c21_sleep: i2c21_sleep {
		group1 {
			psels = <NRF_PSEL(TWIM_SDA, 1, 3)>,
				<NRF_PSEL(TWIM_SCL, 1, 4)>;
			low-power-enable;
		};
	};
};

&i2c21 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_STANDARD>;   /* 100 kHz, same as imu_read */
	pinctrl-0 = <&i2c21_default>;
	pinctrl-1 = <&i2c21_sleep>;
	pinctrl-names = "default", "sleep";

	/* Child node = a device ON this bus. The unit-address (@29) and the reg
	   property must both be the sensor's 7-bit I2C address. `compatible`
	   selects Zephyr's in-tree driver, and its presence is what turns
	   CONFIG_VL53L0X on. The `tof:` label is how main.c finds it via
	   DT_NODELABEL(tof). */
	tof: vl53l0x@29 {
		compatible = "st,vl53l0x";
		reg = <0x29>;

		/* Optional. Only needed if XSHUT is physically wired — it lets the
		   driver hardware-reset the sensor. Active LOW. Uncomment and set
		   the real pin if you wired it. */
		/* xshut-gpios = <&gpio1 10 GPIO_ACTIVE_LOW>; */
	};
};
